# Copiar a .env y rellenar. .env NUNCA se sube a git.
OPENAI_API_KEY="sk-proj-..."
# Modelo de edicion de imagen
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
# medium: +3,5 s sobre low, pero recupera detalle que el sensor no da
OPENAI_IMAGE_QUALITY=medium
# high mantiene reconocible a la persona de la foto
OPENAI_INPUT_FIDELITY=high
# Resolucion de la LCD
LCD_WIDTH=240
LCD_HEIGHT=320
# Lado del cuadro de imagen: el proxy devuelve RGB565 de IMAGE_SIZE x IMAGE_SIZE
IMAGE_SIZE=240
